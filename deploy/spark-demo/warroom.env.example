# Copy to ~/.westie/warroom.env (chmod 600). Never commit the real file.
# Finals demo: no supervisor PIN prompt on the LAN (PR #191). Leave it out to require the PIN.
WARROOM_NO_PIN=1
# Or, with the PIN on: a random PIN, e.g. $(openssl rand -hex 6)
# WARROOM_SUPERVISOR_PIN=<your-pin>
# Demo key row / trigger menu (/api/sim/*). The Spark compose stack defaults to 0 (deploy/spark-demo/compose-demo.env
# turns it on there); this venv run gets the app default, set here so it is explicit.
WARROOM_DEMO_CONTROLS=1
