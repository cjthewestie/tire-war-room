# Copy to deploy/spark/.env on the Spark. docker compose reads it automatically.
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
QDRANT_IMAGE=qdrant/qdrant:v1.15.4
APP_IMAGE=warroom-app:latest
HF_CACHE=/opt/warroom/hf
QDRANT_DATA=/opt/warroom/data/qdrant
APP_DATA=/opt/warroom/data/runtime
# REQUIRED. Supervisor PIN for writes from the factory LAN: the phone page asks for it once and sends it as
# X-Supervisor-Pin on every approval. 8+ random characters, e.g.  openssl rand -base64 9
# The on-box touchscreen (127.0.0.1; the app runs on the host network) needs no PIN.
# install_spark.sh refuses to finish while this is empty or shorter than 8, and compose refuses to start.
# Or pass it at install time:  sudo WARROOM_SUPERVISOR_PIN=... deploy/bin/install_spark.sh
WARROOM_SUPERVISOR_PIN=
# The app listens on every host interface on :8000 (touchscreen on loopback, phone on the LAN).
# Production model server. Control group (page 10): QUANT=fp8 SPEC=off PREFIX_CACHE=0 KV_DTYPE=auto
QUANT=nvfp4
SPEC=dspark
PREFIX_CACHE=1
KV_DTYPE=fp8
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=4
# 0.23 x 128 GB = ~29.4 GB for vLLM -> stack ~48-49 GB (page-9 band 36-50). See vllm-serve.sh.
GPU_MEM_UTIL=0.23
# App
LLM_MODE=llm
SCENARIO=normal
SIM_SPEED=1.0
