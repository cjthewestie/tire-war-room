{"chunk_id": "SOP-01-C1", "sop_id": "SOP-01", "title": "A 線開煉機膠溫異常處置", "section": "目的與適用範圍", "text": "適用 A03 大開煉機、A04 小開煉機與 A06 冷卻機之膠溫異常。未加硫膠溫上限 120°C，超過會提前焦燒、整批報廢。", "equipment": ["A03", "A04", "A06"], "keywords": ["開煉機", "過熱", "冷卻水", "膠溫", "焦燒"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-01-C2", "sop_id": "SOP-01", "title": "A 線開煉機膠溫異常處置", "section": "觸發條件與徵兆", "text": "A03 膠溫持續上升且冷卻水流量低於 30 L/min（正常約 38）、馬達電流同步上升，視為冷卻失效；A04、A06 溫度隨後數分鐘緩升為連鎖徵兆。", "equipment": ["A03", "A04", "A06"], "keywords": ["開煉機", "過熱", "冷卻水", "膠溫", "焦燒"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-01-C3", "sop_id": "SOP-01", "title": "A 線開煉機膠溫異常處置", "section": "處置步驟", "text": "1) 降低 A03 滾筒轉速與進料量；2) 檢查冷卻水閥、過濾網與泵浦壓力，必要時切換備援水路；3) 膠溫達 115°C 先暫停進料，滾筒空轉降溫；4) 受影響批次（已在 A03/A04 的膠）標記待判；5) 回溫至 95°C 以下並連續 5 分鐘穩定才恢復進料。", "equipment": ["A03", "A04", "A06"], "keywords": ["開煉機", "過熱", "冷卻水", "膠溫", "焦燒"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-01-C4", "sop_id": "SOP-01", "title": "A 線開煉機膠溫異常處置", "section": "安全與禁止事項", "text": "禁止在膠溫高於 110°C 時徒手清料；不得以加大轉速取代降溫；未確認水路恢復前不得復機。", "equipment": ["A03", "A04", "A06"], "keywords": ["開煉機", "過熱", "冷卻水", "膠溫", "焦燒"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-01-C5", "sop_id": "SOP-01", "title": "A 線開煉機膠溫異常處置", "section": "紀錄與升級", "text": "於異常紀錄單填入起點時間、峰值膠溫、受影響胎編號（#A 開頭）；膠溫曾達 115°C 以上或停機超過 30 分鐘，通知生管重排並升級班長。", "equipment": ["A03", "A04", "A06"], "keywords": ["開煉機", "過熱", "冷卻水", "膠溫", "焦燒"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-02-C1", "sop_id": "SOP-02", "title": "密煉機開機暖機與換批", "section": "目的與適用範圍", "text": "適用 A01、B01 密煉機。單批 150 kg、混煉約 10 分鐘；各班開煉機於工作窗開始先暖機 30 分鐘。", "equipment": ["A01", "B01"], "keywords": ["密煉機", "暖機", "批次", "150kg"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-02-C2", "sop_id": "SOP-02", "title": "密煉機開機暖機與換批", "section": "觸發條件與徵兆", "text": "每班開始、換配方、或停機超過 2 小時後須暖機；批次數依投料重量計算：A 線混 80%、B 線混 15%，向上取整。", "equipment": ["A01", "B01"], "keywords": ["密煉機", "暖機", "批次", "150kg"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-02-C3", "sop_id": "SOP-02", "title": "密煉機開機暖機與換批", "section": "處置步驟", "text": "1) 確認轉子與腔體溫度；2) 空轉暖機 30 分鐘；3) 依配方單投料並記錄批號；4) 每批混煉 10 分鐘後卸料至開煉機。小胎 A 線 6 批、中胎 8 批、大胎 11 批。", "equipment": ["A01", "B01"], "keywords": ["密煉機", "暖機", "批次", "150kg"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-02-C4", "sop_id": "SOP-02", "title": "密煉機開機暖機與換批", "section": "安全與禁止事項", "text": "投料前確認防護門連鎖；異物（金屬、塑膠）須先篩除；禁止超過額定 150 kg。", "equipment": ["A01", "B01"], "keywords": ["密煉機", "暖機", "批次", "150kg"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-02-C5", "sop_id": "SOP-02", "title": "密煉機開機暖機與換批", "section": "紀錄與升級", "text": "批號、投料重量、排料溫度記入批次紀錄；排料溫度超過 120°C 立即停止後續批次並通報品保。", "equipment": ["A01", "B01"], "keywords": ["密煉機", "暖機", "批次", "150kg"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-03-C1", "sop_id": "SOP-03", "title": "L01 貼合油壓機作業", "section": "目的與適用範圍", "text": "適用 L01 貼合油壓機（全廠僅 1 台）。貼合單條小/中/大胎約 40/60/90 分鐘，為 A/B/C/D 線半成品的匯流點。", "equipment": ["L01"], "keywords": ["貼合", "油壓機", "胎側膠", "鋼絲圈"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-03-C2", "sop_id": "SOP-03", "title": "L01 貼合油壓機作業", "section": "觸發條件與徵兆", "text": "A 線膠料、胎側膠、鋼絲圈、尼龍布四項半成品齊備，且貼合組在班；任一缺料不得開始貼合。", "equipment": ["L01"], "keywords": ["貼合", "油壓機", "胎側膠", "鋼絲圈"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-03-C3", "sop_id": "SOP-03", "title": "L01 貼合油壓機作業", "section": "處置步驟", "text": "1) 核對胎編號與四項半成品；2) 依序鋪放尼龍布、鋼絲圈、胎側膠；3) 壓合並檢視氣泡與錯位；4) 合格胎胚交入模。", "equipment": ["L01"], "keywords": ["貼合", "油壓機", "胎側膠", "鋼絲圈"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-03-C4", "sop_id": "SOP-03", "title": "L01 貼合油壓機作業", "section": "安全與禁止事項", "text": "手不得伸入壓合區；胎胚堆放不得超過 36 小時（半成品）與 10 小時（A 線膠料），逾時退回重煉。", "equipment": ["L01"], "keywords": ["貼合", "油壓機", "胎側膠", "鋼絲圈"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-03-C5", "sop_id": "SOP-03", "title": "L01 貼合油壓機作業", "section": "紀錄與升級", "text": "貼合開始/結束時間、操作者、不良原因記錄；L01 為單機瓶頸，停機超過 1 小時須通知生管重排。", "equipment": ["L01"], "keywords": ["貼合", "油壓機", "胎側膠", "鋼絲圈"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-04-C1", "sop_id": "SOP-04", "title": "入模、出模與換模作業", "section": "目的與適用範圍", "text": "適用 11 台硫化機的入模與出模。入模、出模各 30 分鐘，必須在有人值班的工作窗內完成；週日不出入模。", "equipment": ["V01-V11"], "keywords": ["入模", "出模", "換模", "模具", "8 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-04-C2", "sop_id": "SOP-04", "title": "入模、出模與換模作業", "section": "觸發條件與徵兆", "text": "胎胚貼合完成即可入模；硫化計時到點進入出模；中胎機改做大胎（或相反）需換模。", "equipment": ["V01-V11"], "keywords": ["入模", "出模", "換模", "模具", "8 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-04-C3", "sop_id": "SOP-04", "title": "入模、出模與換模作業", "section": "處置步驟", "text": "1) 入模：確認模具溫度達標、胎編號對應機台，合模後啟動硫化計時；2) 出模：洩壓、開模、取胎、放置冷卻區；3) 換模共 8 小時（冷卻 6 + 更換 1 + 開機 1），僅 V08–V11 可換。", "equipment": ["V01-V11"], "keywords": ["入模", "出模", "換模", "模具", "8 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-04-C4", "sop_id": "SOP-04", "title": "入模、出模與換模作業", "section": "安全與禁止事項", "text": "洩壓未歸零不得開模；高溫模具須使用隔熱手套與吊具；換模期間機台掛牌。", "equipment": ["V01-V11"], "keywords": ["入模", "出模", "換模", "模具", "8 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-04-C5", "sop_id": "SOP-04", "title": "入模、出模與換模作業", "section": "紀錄與升級", "text": "入模/出模實際時間、模具編號、換模起訖記入明細；換模排程由生管決定，不得臨時於夜班自行換模。", "equipment": ["V01-V11"], "keywords": ["入模", "出模", "換模", "模具", "8 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-05-C1", "sop_id": "SOP-05", "title": "硫化機溫度偏低與等效硫化處置", "section": "目的與適用範圍", "text": "適用硫化機模溫低於標準下限 120°C，或明顯偏離 128°C 設定。標準溫度 120–130°C、壓力 20 kgf/cm²。", "equipment": ["V01-V11"], "keywords": ["硫化", "降溫", "Arrhenius", "等效硫化", "128"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-05-C2", "sop_id": "SOP-05", "title": "硫化機溫度偏低與等效硫化處置", "section": "觸發條件與徵兆", "text": "模溫自 128°C 連續下降（例如 128→122→119.5°C），而相鄰機台正常，表示單機問題；低於 120°C 即進入安全核心處置。", "equipment": ["V01-V11"], "keywords": ["硫化", "降溫", "Arrhenius", "等效硫化", "128"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-05-C3", "sop_id": "SOP-05", "title": "硫化機溫度偏低與等效硫化處置", "section": "處置步驟", "text": "1) 立即確認蒸汽壓力與流量，排除疏水閥、供汽閥問題；2) 以 Arrhenius 估算等效硫化：總時間 = 已硫化時間 + 剩餘時間 × 倍數，倍數 = exp(Ea/R × (1/T − 1/T_ref))，Ea = 85 kJ/mol、T_ref = 128°C；122°C 約 1.47 倍、119.5°C 約 1.74 倍；3) 評估延長硫化時間並重算出模時間、下游整修與交期；4) 溫度無法在 15 分鐘內恢復者，通知生管評估改用空閒機台。", "equipment": ["V01-V11"], "keywords": ["硫化", "降溫", "Arrhenius", "等效硫化", "128"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-05-C4", "sop_id": "SOP-05", "title": "硫化機溫度偏低與等效硫化處置", "section": "安全與禁止事項", "text": "不得以提高壓力取代溫度；不得未經品保評估即縮短硫化時間；低於 120°C 的產品必須以延長時間補足並標記追蹤。", "equipment": ["V01-V11"], "keywords": ["硫化", "降溫", "Arrhenius", "等效硫化", "128"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-05-C5", "sop_id": "SOP-05", "title": "硫化機溫度偏低與等效硫化處置", "section": "紀錄與升級", "text": "紀錄降溫曲線、延長時間、受影響胎編號與交期影響；延長後出模落在無人窗時，須同步通知生管與班長，並更新稽核紀錄。", "equipment": ["V01-V11"], "keywords": ["硫化", "降溫", "Arrhenius", "等效硫化", "128"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-06-C1", "sop_id": "SOP-06", "title": "蒸汽壓力異常與疏水閥檢查", "section": "目的與適用範圍", "text": "適用硫化機夾套蒸汽壓力異常。飽和蒸汽溫度與壓力一一對應，128°C 約 2.46 bar（絕對壓）。", "equipment": ["V01-V11"], "keywords": ["蒸汽", "壓力", "疏水閥", "飽和"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-06-C2", "sop_id": "SOP-06", "title": "蒸汽壓力異常與疏水閥檢查", "section": "觸發條件與徵兆", "text": "壓力與模溫不符飽和關係（壓力正常但溫度低，表示有不凝結氣體或積水；壓力低同時溫度低，表示供汽不足）。", "equipment": ["V01-V11"], "keywords": ["蒸汽", "壓力", "疏水閥", "飽和"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-06-C3", "sop_id": "SOP-06", "title": "蒸汽壓力異常與疏水閥檢查", "section": "處置步驟", "text": "1) 檢查疏水閥是否卡滯；2) 排放冷凝水與不凝結氣體；3) 檢視總管供汽壓力與其他機台是否同步下降；4) 恢復後觀察 10 分鐘趨勢。", "equipment": ["V01-V11"], "keywords": ["蒸汽", "壓力", "疏水閥", "飽和"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-06-C4", "sop_id": "SOP-06", "title": "蒸汽壓力異常與疏水閥檢查", "section": "安全與禁止事項", "text": "檢修前關閉並洩放夾套壓力；高溫管線不得徒手觸碰。", "equipment": ["V01-V11"], "keywords": ["蒸汽", "壓力", "疏水閥", "飽和"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-06-C5", "sop_id": "SOP-06", "title": "蒸汽壓力異常與疏水閥檢查", "section": "紀錄與升級", "text": "壓力/溫度曲線截圖存檔；同一機台一週內重複發生 2 次須開立維修工單。", "equipment": ["V01-V11"], "keywords": ["蒸汽", "壓力", "疏水閥", "飽和"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-07-C1", "sop_id": "SOP-07", "title": "出模後冷卻與整修", "section": "目的與適用範圍", "text": "適用硫化出模後的靜置冷卻與修邊整修。冷卻固定 4 小時，整修每條約 20 分鐘。", "equipment": ["T01"], "keywords": ["冷卻", "整修", "修邊", "4 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-07-C2", "sop_id": "SOP-07", "title": "出模後冷卻與整修", "section": "觸發條件與徵兆", "text": "出模後胎表面溫度高於 60°C 不得整修；修邊組在班時才可開始整修。", "equipment": ["T01"], "keywords": ["冷卻", "整修", "修邊", "4 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-07-C3", "sop_id": "SOP-07", "title": "出模後冷卻與整修", "section": "處置步驟", "text": "1) 於冷卻區靜置 4 小時；2) 以人工去除毛邊、溢膠；3) 目視檢查外觀、尺寸；4) 合格品入庫。", "equipment": ["T01"], "keywords": ["冷卻", "整修", "修邊", "4 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-07-C4", "sop_id": "SOP-07", "title": "出模後冷卻與整修", "section": "安全與禁止事項", "text": "堆疊高度不得超過 3 條；冷卻區禁止風扇直吹局部造成不均勻降溫。", "equipment": ["T01"], "keywords": ["冷卻", "整修", "修邊", "4 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-07-C5", "sop_id": "SOP-07", "title": "出模後冷卻與整修", "section": "紀錄與升級", "text": "整修完成時間即為該胎完工時間；不良品記錄缺陷類型與數量。", "equipment": ["T01"], "keywords": ["冷卻", "整修", "修邊", "4 小時"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-08-C1", "sop_id": "SOP-08", "title": "B 線胎側膠製作", "section": "目的與適用範圍", "text": "適用 B 線（胎側膠）。單側 3/6/10 片（小/中/大），雙側 6/12/20 片。", "equipment": ["B01", "B02", "B03", "B04"], "keywords": ["胎側膠", "B 線", "壓片", "組裝"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-08-C2", "sop_id": "SOP-08", "title": "B 線胎側膠製作", "section": "觸發條件與徵兆", "text": "貼合排程確定後，往前推算 B 線開工時間；半成品存放不得超過 36 小時。", "equipment": ["B01", "B02", "B03", "B04"], "keywords": ["胎側膠", "B 線", "壓片", "組裝"], "lang": "zh-TW", "synthetic": true}
{"chunk_id": "SOP-08-C3", "sop_id": "SOP-08", "title": "B 線胎側膠製作", "section": "處置步驟", "text": "1) 密煉（A 線重量的 15%，向上取整批數）；2) 壓片；3) 成形；4) 冷卻靜置；5) 組裝成胎側膠組。", "equipment": ["B01", "B02", "B03", "B04"], "keywords": ["胎側膠", "B 線", "壓片", "組裝"], "lang": "zh-TW", "synthetic": true}
